# Authentication secret key (minimum 32 characters, required for JWT generation)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=generate_with_python_secrets_token_hex_32
AUTH_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./travel_planner.db

# Frontend CORS origins (comma-separated, Vite runs on 5173, Next.js on 3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# LLM & Search API Keys (Free Tier / Trials Supported)
# ---------------------------------------------------------------------------

# 1. Google Gemini (Primary LLM for Chat Refinement & Direct Generation)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
# ⚠️  The old name "gemini-1.5-flash" is DEPRECATED — use the value below.
GEMINI_MODEL=gemini-flash-lite-latest

# 2. Groq — Multi-Key Architecture (1 key per agent = 3× free-tier quota)
# Each CrewAI agent uses its own dedicated Groq key so quotas are independent.
# Get free keys at: https://console.groq.com/ (one account per key)
#
# Per-agent keys (preferred — set all three for full quota isolation):
GROQ_API_KEY_CONTEXT=gsk_your_context_agent_key_here
GROQ_API_KEY_SEARCH=gsk_your_search_agent_key_here
GROQ_API_KEY_PLANNER=gsk_your_planner_agent_key_here
#
# Shared fallback key (used when a per-agent key is missing or empty):
GROQ_API_KEY=gsk_your_default_key_here
#
GROQ_MODEL=qwen/qwen3.8-27b

# 3. Tavily Search (Used by Search Agent in CrewAI multi-agent pipeline)
# Free 1,000 monthly searches at: https://tavily.com/
TAVILY_API_KEY=
# 4. AgentOps (optional — enables the A1 performance dashboard & session tracing)
# Get a free key at: https://app.agentops.ai/
AGENTOPS_API_KEY=
