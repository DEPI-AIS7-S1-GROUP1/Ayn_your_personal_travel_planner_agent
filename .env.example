# Authentication secret key (minimum 32 characters, required for JWT generation)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=generate_with_python_secrets_token_hex_32
AUTH_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./travel_planner.db

# Frontend CORS origins (comma-separated, Vite runs on 5173, Next.js on 3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# LLM & Search API Keys (Free Tier / Trials Supported)
# ---------------------------------------------------------------------------

# 1. Google Gemini (Primary LLM for Chat Refinement & Direct Generation)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq (Backup LLM for high-speed fallback when Gemini limits are hit)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 3. Tavily Search (Used by Search Agent in CrewAI multi-agent pipeline)
# Free 1,000 monthly searches at: https://tavily.com/
TAVILY_API_KEY=

