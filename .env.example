# Authentication secret key (minimum 32 characters, required for JWT generation).
# Left empty on purpose: the server refuses to start until you set your own. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=
# How long a login stays valid, in minutes. 60 locally; on the live host use 1440 (a full demo day).
AUTH_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./travel_planner.db

# Frontend CORS origins (comma-separated, Vite runs on 5173, Next.js on 3000).
# On the live host, add the Vercel address, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Demo data (backend/scripts/seed_demo.py). When SEED_DEMO_DATA=true the demo users, their
# profiles and one confirmed plan are recreated on every start if they are missing.
# Free hosts can reset SQLite on restart, so turn this on in the live deployment.
SEED_DEMO_DATA=false
# Password for every demo account. Required when SEED_DEMO_DATA=true; never commit a real one.
DEMO_USER_PASSWORD=

# ---------------------------------------------------------------------------
# LLM & Search API Keys (Free Tier / Trials Supported)
# ---------------------------------------------------------------------------

# 1. Google Gemini (Primary LLM for CrewAI plan generation and chat)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
# ⚠️  The old name "gemini-1.5-flash" is DEPRECATED — use the value below.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_S=20
AGENT_GEMINI_TIMEOUT_S=20
AGENT_GLOBAL_TIMEOUT_S=40
AGENT_TOTAL_TIMEOUT_S=75
AGENT_GROQ_TIMEOUT_S=30
# Seconds to wait before one retry of Tier 1 when Gemini answers 503 (high demand)
AGENT_GEMINI_RETRY_DELAY_S=2
GROQ_REQUEST_TIMEOUT_S=25
GROQ_MAX_OUTPUT_TOKENS=

# 2. Groq — Multi-Key Architecture (1 key per agent = 3× free-tier quota)
# Each CrewAI agent uses its own dedicated Groq key so quotas are independent.
# Get free keys at: https://console.groq.com/ (one account per key)
#
# Per-agent keys (preferred — set all three for full quota isolation):
GROQ_API_KEY_CONTEXT=gsk_your_context_agent_key_here
GROQ_API_KEY_SEARCH=gsk_your_search_agent_key_here
GROQ_API_KEY_PLANNER=gsk_your_planner_agent_key_here
#
# Shared fallback key (used when a per-agent key is missing or empty):
GROQ_API_KEY=gsk_your_default_key_here
#
# qwen/qwen3.8-27b is limited to 1,000 output tokens per minute on the free tier: too few
# for a full plan, so every plan fell back to the templates. gpt-oss-120b allows 8,000.
GROQ_MODEL=openai/gpt-oss-120b

# 3. Tavily Search (Used by Search Agent in CrewAI multi-agent pipeline)
# Free 1,000 monthly searches at: https://tavily.com/
TAVILY_API_KEY=
TAVILY_MAX_SEARCH_QUERIES=2
TAVILY_MAX_RESULTS=5
TAVILY_MAX_CONTENT_CHARS=1500
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_S=12
TAVILY_CACHE_TTL_HOURS=72
# 4. AgentOps (optional — enables the A1 performance dashboard & session tracing)
# Get a free key at: https://app.agentops.ai/
AGENTOPS_API_KEY=
