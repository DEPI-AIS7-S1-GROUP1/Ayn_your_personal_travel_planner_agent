# ---------------------------------------------------------------
# Environment variables template.
#
#   cp .env.example .env      # then fill in YOUR values in .env
#
# .env is git-ignored. NEVER put real keys or passwords in this
# file (.env.example) — it is committed and public to the team.
# ---------------------------------------------------------------

# ---------- Backend (Task 4) ----------

# Database connection string.
# Local development uses a SQLite file (no install needed).
# Deployment (Sprint 3) will switch this to a hosted PostgreSQL URL.
DATABASE_URL=sqlite:///./travel_planner.db

# Secret used to sign login tokens. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# How long a login stays valid, in minutes.
AUTH_TOKEN_EXPIRE_MINUTES=60

# Frontend origin(s) allowed to call the backend (comma-separated).
CORS_ORIGINS=http://localhost:3000

# ---------- Agent (Task 3) ----------
# Final LLM provider is pending the Task 3 decision.
# Fill in only the ones the agent actually uses.
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
